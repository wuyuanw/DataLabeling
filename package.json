{
  "name": "sop-data-workbench",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "capture": "npm run build && electron scripts/capture.cjs",
    "preview": "vite preview",
    "start": "electron . --production"
  },
  "dependencies": {
    "element-plus": "^2.11.2",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "vite": "^7.1.4",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.2": true
  }
}
